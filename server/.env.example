# Copy this file to .env and fill in your key.
# Google Cloud Console → enable "Places API (New)" → Credentials → API key.
# Restrict the key to the Places API (New). Never commit .env.
GOOGLE_MAPS_API_KEY=

PORT=4000
CORS_ORIGIN=http://localhost:5173

# Reviews. Leave empty on your computer (saved to data/reviews.json).
# Online, use a free MongoDB Atlas database, or reviews disappear when the host restarts.
MONGODB_URI=

# Secret password for deleting spam reviews (any long random text). Keep it private.
ADMIN_TOKEN=
